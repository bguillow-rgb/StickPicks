{
  // Cloudflare Workers Static Assets config for the stickpicks.app site.
  //
  // The Astro site lives in /web. Cloudflare's build environment runs
  // the configured Build command (which cd's into /web and produces
  // /web/dist), then Wrangler deploys whatever is in `assets.directory`
  // below. No serverless functions \u2014 it's a pure static deploy.
  //
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickpicks",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./web/dist",
    // SPA-style fallback off. Astro generates .html files at clean
    // paths (/about.html, /privacy.html, etc.) and Cloudflare's HTML
    // handling resolves /about \u2192 /about.html automatically.
    "not_found_handling": "404-page"
  }
}
