{
  "expo": {
    "name": "Stick Picks",
    "slug": "stick-picks",
    "owner": "bg233",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stickpicks",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bobguillow.stickpicks",
      "infoPlist": {
        "NSCameraUsageDescription": "Stick Picks uses your camera to identify cigars by scanning the band or wrapper."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1A0F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bobguillow.stickpicks"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
