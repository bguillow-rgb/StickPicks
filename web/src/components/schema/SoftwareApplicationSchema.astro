---
import { SITE } from '../../consts';

// WebApplication schema. Stick Picks runs free in any browser at /app, so the
// canonical install surface is the web app (not an app-store download). If an
// iOS/Android build later ships, emit an additional MobileApplication node.
//
// aggregateRating is intentionally omitted until there are real ratings;
// fabricating ratings is a manual-action risk.
const base: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: SITE.name,
  description: SITE.description,
  url: SITE.appUrl,
  operatingSystem: 'Any',
  browserRequirements: 'Requires a modern browser with JavaScript enabled.',
  applicationCategory: 'LifestyleApplication',
  // Free to use on the web; an optional Pro tier exists on native builds.
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(base)} />
