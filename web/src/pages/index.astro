---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import SoftwareApplicationSchema from '../components/schema/SoftwareApplicationSchema.astro';
import { SITE } from '../consts';

// Latest 3 published articles for the homepage "From the Blog" teaser.
// Drafts are excluded automatically because they have published:false.
const latestArticles = (
  await getCollection('articles', ({ data }) => data.published)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const quickAnswer =
  'Stick Picks is a free web app for adult cigar collectors that runs in any ' +
  'browser. It catalogs your humidor, scans cigar bands to identify what you ' +
  'own, tracks the value of your collection over time, and gives you a private ' +
  'journal for every cigar in your collection. It does not sell tobacco.';

const faqs = [
  {
    q: 'What is Stick Picks?',
    a:
      'Stick Picks is a free web app for adult cigar collectors. You catalog your humidor, scan bands to identify cigars, track collection value, and log tasting notes, all in one private reference, right in your browser.',
  },
  {
    q: 'Do I need to download anything?',
    a:
      'No. Stick Picks runs entirely in your browser at stickpicks.app/app, on desktop or phone. There is nothing to install and no app store required. Add it to your home screen for one-tap access.',
  },
  {
    q: 'Is Stick Picks a retailer?',
    a:
      'No. Stick Picks does not sell cigars, distribute tobacco, or promote tobacco consumption. It is a reference, journal, and humidor catalog for collectors.',
  },
  {
    q: 'How old do I have to be to use Stick Picks?',
    a:
      'Stick Picks is intended for adults aged 21 and older, matching the United States federal minimum legal age to purchase tobacco. A 21+ age gate is enforced on first launch.',
  },
  {
    q: 'How does the cigar band scanner work?',
    a:
      'Snap or upload a clear photo of the cigar band. Our Cigar Concierge reads the brand and line text and matches it against the catalog. If recognition fails, you can retry with a sharper photo, search manually, or suggest a cigar to be added.',
  },
  {
    q: 'Is Stick Picks free?',
    a:
      'Yes. The web app is free to use with every feature unlocked, including the band scanner, humidor catalog, collection value tracking, and journaling.',
  },
  {
    q: 'Is my collection data private?',
    a:
      'Yes. Your humidor, journal entries, scan history, and ratings are tied to your account and never shared, sold, or used for advertising. See the Privacy Policy for the full breakdown.',
  },
  {
    q: 'Do I need an iPhone or Android phone?',
    a:
      'No. Stick Picks works on any device with a modern browser, including desktop, laptop, iPhone, and Android. Native app-store versions are on the roadmap, but the full experience is already available on the web.',
  },
];
---
<BaseLayout
  title={SITE.name}
  description={SITE.description}
  path="/"
>
  <Fragment slot="head">
    <SoftwareApplicationSchema />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:image" content={`${SITE.url}/icon.png`} />
  </Fragment>

  <section class="hero">
    <img src="/icon.png" alt="Stick Picks app icon" class="hero-icon" width="96" height="96" />
    <p class="brand">{SITE.name}</p>
    <h1>{SITE.tagline}</h1>
    <p class="hero-tagline">
      Catalog your humidor, identify any cigar by its band, and build your
      tasting log &mdash; free, right in your browser. No download required.
    </p>

    <div class="cta-row">
      <a class="cta cta--primary" href={SITE.appUrl}>Open the app &rarr;</a>
    </div>
    <p class="hero-trust">No download &middot; No ads &middot; For adults 21+ &middot; Your collection stays yours</p>

    <img
      src="/assets/screenshots/02-home.png"
      alt="Stick Picks home screen showing Quick Match, Advanced Quiz, and Scan a Stick options"
      class="hero-shot"
      loading="eager"
    />
  </section>

  <QuickAnswer text={quickAnswer} />

  <section class="features">
    <h2 class="section-title">Built for collectors</h2>

    <div class="feature-grid">
      <div class="feature">
        <div class="feature-icon" aria-hidden="true">&#9783;</div>
        <h3>Your humidor, organized</h3>
        <p>Track every stick by brand, vitola, wrapper, and rest time. Snap the band, we'll do the rest.</p>
      </div>

      <div class="feature">
        <div class="feature-icon" aria-hidden="true">&#9998;</div>
        <h3>A journal that remembers</h3>
        <p>Log each cigar with tasting notes, ratings, pairings, and the occasion. Your collection's history, searchable.</p>
      </div>

      <div class="feature">
        <div class="feature-icon" aria-hidden="true">&#36;</div>
        <h3>Collection value at a glance</h3>
        <p>MSRP-aware pricing keeps a running total of what's resting in your humidor.</p>
      </div>

      <div class="feature">
        <div class="feature-icon" aria-hidden="true">&#9788;</div>
        <h3>Discover what you'll love</h3>
        <p>A short profile quiz finds catalog entries matched to your palate, from a curated database of premium handmade cigars.</p>
      </div>
    </div>

    <p class="features-link"><a href="/features">See every feature &rarr;</a></p>
  </section>

  <h2>Is Stick Picks really free?</h2>
  <p>
    Yes. The web app is free to use with every feature unlocked. There are no
    ads, no data selling, and no tobacco promotion. Stick Picks does not sell
    cigars &mdash; it is a private reference, journal, and humidor catalog for
    collectors.
  </p>

  <div class="cta-row">
    <a class="cta cta--primary" href={SITE.appUrl}>Open Stick Picks &rarr;</a>
  </div>

  {latestArticles.length > 0 && (
    <section class="blog-teaser">
      <h2 class="section-title">From the Blog</h2>
      <ul class="blog-list">
        {latestArticles.map((a) => (
          <li>
            <a href={`/articles/${a.slug}`}>{a.data.title}</a>
            <p>{a.data.description}</p>
          </li>
        ))}
      </ul>
      <p class="features-link"><a href="/articles">All articles &rarr;</a></p>
    </section>
  )}

  <FAQ faqs={faqs} />

  <Footer />
</BaseLayout>
