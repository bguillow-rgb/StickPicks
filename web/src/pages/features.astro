---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Features"
  description="A closer look at Stick Picks: humidor catalog, tasting journal, cigar identification, palate-matching quiz, and curated browse."
  path="/features"
  wide
>
  <Fragment slot="head">
    <BreadcrumbSchema crumbs={[{ name: 'Features', url: `${SITE.url}/features` }]} />
    <link rel="apple-touch-icon" href="/icon.png" />
  </Fragment>

  <p class="brand">{SITE.name}</p>
  <h1>Features</h1>
  <p class="effective">Everything Stick Picks does, in one place.</p>

  <section class="feature-row">
    <div class="feature-row-copy">
      <h3>Your humidor, organized</h3>
      <p>Track every cigar by brand, vitola, and rest time. Mark cigars Owned, Wishlist, or Logged, and capture your own ratings as you build out your tasting journal.</p>
      <p>Filter by status, search by name, and see at a glance what's resting and what's earned a place on the wishlist.</p>
    </div>
    <div class="feature-row-shot">
      <img
        src="/assets/screenshots/01-humidor.png"
        alt="Humidor screen showing cigars tagged Owned, Wishlist, and Logged with star ratings"
        loading="lazy"
      />
    </div>
  </section>

  <section class="feature-row feature-row--reverse">
    <div class="feature-row-shot">
      <img
        src="/assets/screenshots/04-browse-medium.png"
        alt="Browse Cigars filtered by Medium strength, showing cigars with flavor tags like cedar, pepper, and cream"
        loading="lazy"
      />
    </div>
    <div class="feature-row-copy">
      <h3>A catalog built for discovery</h3>
      <p>Browse a curated database of premium handmade cigars. Filter by strength, search by brand or name, and explore by flavor, cedar, pepper, cream, baking spice, and dozens more.</p>
      <p>Every entry is curated with notes, pairings, and a path back to your humidor.</p>
    </div>
  </section>

  <section class="feature-row">
    <div class="feature-row-copy">
      <h3>Match your palate to your humidor</h3>
      <p>Profile Match asks three questions and matches your palate to catalog entries worth adding to your collection. The Detailed Match goes nine deep for precision matching.</p>
      <p>Or skip the questions entirely, point your camera at any cigar band and Identify by Band handles the lookup on the spot.</p>
    </div>
    <div class="feature-row-shot">
      <img
        src="/assets/screenshots/02-home.png"
        alt="Stick Picks home screen with Profile Match, Detailed Match, and Identify by Band"
        loading="lazy"
      />
    </div>
  </section>

  <section class="feature-row feature-row--reverse">
    <div class="feature-row-shot">
      <img
        src="/assets/screenshots/05-profile.png"
        alt="Profile screen showing humidor stats, cigars owned, cigars logged, and scans completed"
        loading="lazy"
      />
    </div>
    <div class="feature-row-copy">
      <h3>Your collection at a glance</h3>
      <p>Your profile keeps a running tally, cigars in your humidor, entries logged, scans completed.</p>
      <p>Everything stays private and tied to your account. No social feed, no leaderboards, no nudges to consume, just a clean record of your collection.</p>
    </div>
  </section>

  <section class="cta">
    <h2 class="section-title">Ready when you are</h2>
    <p class="cta-body">
      Stick Picks is free and runs right in your browser &mdash; nothing to install.
      Open it now, or email <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a> with questions or feedback.
    </p>
    <div class="cta-row">
      <a class="cta cta--primary" href={SITE.appUrl}>Open the app &rarr;</a>
    </div>
  </section>

  <Footer />
</BaseLayout>
